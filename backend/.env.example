# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Database ----------
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/safarsplit

# ---------- Auth ----------
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ==========================================================
# AI PROVIDER — pick one
# ==========================================================
# AI_PROVIDER = "ollama"             → free, local, private, offline
# AI_PROVIDER = "openai-compatible"  → any cloud provider with /v1/chat/completions
#
# Examples:
#   Ollama + Gemma:           AI_PROVIDER=ollama  AI_MODEL=gemma2:9b
#   Ollama + DeepSeek (local):AI_PROVIDER=ollama  AI_MODEL=deepseek-r1:7b
#   DeepSeek API:             AI_PROVIDER=openai-compatible  AI_API_URL=https://api.deepseek.com  AI_MODEL=deepseek-chat
#   DigitalOcean GenAI:       AI_PROVIDER=openai-compatible  AI_API_URL=https://inference.do-ai.run  AI_MODEL=llama3.3-70b-instruct
#   Groq (free tier):         AI_PROVIDER=openai-compatible  AI_API_URL=https://api.groq.com/openai  AI_MODEL=llama-3.3-70b-versatile
#   Together.ai:              AI_PROVIDER=openai-compatible  AI_API_URL=https://api.together.xyz  AI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   OpenRouter:               AI_PROVIDER=openai-compatible  AI_API_URL=https://openrouter.ai/api  AI_MODEL=deepseek/deepseek-chat
# ==========================================================

AI_PROVIDER=ollama
AI_MODEL=gemma2:9b
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1

# Ollama (only used if AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
MODEL_NAME=gemma2:9b

# OpenAI-compatible (only used if AI_PROVIDER=openai-compatible)
AI_API_URL=
AI_API_KEY=

# ---------- OSRM (public routing, optional) ----------
OSRM_URL=https://router.project-osrm.org

# ---------- Rate limits ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=30

# ---------- Currency ----------
DEFAULT_CURRENCY=INR